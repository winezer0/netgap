{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && npm run compile",
    "check": "npm run lint && npm test && node --test ../build.test.mjs",
    "compile": "vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^3.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^22.1.0",
    "vite": "^3.0.7",
    "vitest": "^0.34.6"
  }
}
